<?xml version="1.0" encoding="utf-8"?>
<xsd:schema targetNamespace="http://www.equiplano.com.br/esnfs" xmlns:tipos="http://www.equiplano.com.br/esnfs/tipos" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
	<xsd:import namespace="http://www.equiplano.com.br/esnfs/tipos" schemaLocation="TiposEsnfs_v02.xsd" />
	<xsd:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema_v02.xsd" />
	<xsd:element name="enviarLoteRpsEnvio">
		<xsd:annotation>
			<xsd:documentation>Mensagem de envio do lote de RPS, leiaute versão 2.</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="lote" minOccurs="1" maxOccurs="1">
					<xsd:annotation>
						<xsd:documentation>Lote de RPS de um único prestador.</xsd:documentation>
					</xsd:annotation>
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="nrLote" type="xsd:integer" minOccurs="1" maxOccurs="1">
								<xsd:annotation>
									<xsd:documentation>Número do lote, definido pelo prestador. Não pode repetir um lote já enviado.</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="qtRps" type="xsd:integer" minOccurs="1" maxOccurs="1">
								<xsd:annotation>
									<xsd:documentation>Quantidade de RPS informados em listaRps.</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="nrVersaoXml" type="xsd:integer" fixed="2" minOccurs="1" maxOccurs="1">
								<xsd:annotation>
									<xsd:documentation>Versão do leiaute do lote. No leiaute 2, sempre 2.</xsd:documentation>
								</xsd:annotation>
							</xsd:element>
							<xsd:element name="prestador" type="tipos:tcPrestador" minOccurs="1" maxOccurs="1" />
							<xsd:element name="listaRps" minOccurs="1" maxOccurs="1">
								<xsd:annotation>
									<xsd:documentation>Lista dos RPS do lote, até 1000.</xsd:documentation>
								</xsd:annotation>
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="rps" type="tipos:tcRps" minOccurs="1" maxOccurs="1000" />
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element ref="ds:Signature" minOccurs="1" maxOccurs="1" />
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
