<TfrxReport Tag="1" Version="2026.1.1" DotMatrixReport="False" EngineOptions.DoublePass="True" EngineOptions.UseFileCache="True" IniFile="\Software\Fast Report" PreviewOptions.AllowEdit="False" PreviewOptions.AllowPreviewEdit="False" PreviewOptions.Buttons="191549" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="40401,475989294" ReportOptions.Description.Text="" ReportOptions.LastChange="46316,6167288657" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;function ValorCampo(AValor: Variant): Double;&#13;&#10;var&#13;&#10;  S: String;&#13;&#10;begin&#13;&#10;  S := Trim(VarToStr(AValor));&#13;&#10;  if S = &#39;&#39; then&#13;&#10;    Result := 0&#13;&#10;  else&#13;&#10;    Result := StrToFloat(S);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DadosProdutosHeaderOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;    set(&#39;LinhasImpressas&#39;,0);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure EmitenteOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;  begin&#13;&#10;    if Trim(VarToStr(&#60;Parametros.&#34;Imagem&#34;&#62;)) &#60;&#62; &#39;&#39; then&#13;&#10;    begin&#13;&#10;      if Trim(VarToStr(&#60;Parametros.&#34;LogoExpandido&#34;&#62;)) = &#39;1&#39; then&#13;&#10;      begin&#13;&#10;        MemEmitente.Font.Color := clWhite;&#13;&#10;        MemDadosEmitente.Visible := False;&#13;&#10;        imgLogo.Top := 5;&#13;&#10;        imgLogo.Height := memDadosEmitente.Height + (memDadosEmitente.Top - imgLogo.Top);&#13;&#10;        imgLogo.Width := memDadosEmitente.Width + (memDadosEmitente.Left - imgLogo.Left);&#13;&#10;      end;&#13;&#10;    end&#13;&#10;    else&#13;&#10;    begin&#13;&#10;      MemDadosEmitente.Left := MemEmitente.Left;&#13;&#10;      MemDadosEmitente.Width := MemEmitente.Width;&#13;&#10;      imgLogo.Visible := False;&#13;&#10;    end;&#13;&#10;&#13;&#10;    BarCodeContigencia.Visible := Trim(VarToStr(&#60;Parametros.&#34;Contingencia_ID&#34;&#62;)) &#60;&#62; &#39;&#39;;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;// NT 2026.010 - item 4.4: Transportador / Volumes somente quando houver dados a apresentar&#13;&#10;procedure AjustaTransportador;&#13;&#10;var&#13;&#10;  lExibe: Boolean;&#13;&#10;begin&#13;&#10;  lExibe := ( Trim(VarToStr(&#60;Transportador.&#34;XNome&#34;&#62;)) &#60;&#62; &#39;&#39; ) or&#13;&#10;            ( Trim(VarToStr(&#60;Transportador.&#34;CNPJCPF&#34;&#62;)) &#60;&#62; &#39;&#39; ) or&#13;&#10;            ( Trim(VarToStr(&#60;Transportador.&#34;XEnder&#34;&#62;)) &#60;&#62; &#39;&#39; ) or&#13;&#10;            ( Trim(VarToStr(&#60;Veiculo.&#34;PLACA&#34;&#62;)) &#60;&#62; &#39;&#39; ) or&#13;&#10;            ( Volumes.DataSet.RecordCount &#62; 0 );&#13;&#10;  TransportadorVolumes.Visible := lExibe;&#13;&#10;  Volumes.Visible := lExibe;&#13;&#10;end;&#13;&#10;&#13;&#10;// NT 2026.010 - item 4.4: quadros de exibicao condicionada a existencia da informacao.&#13;&#10;// Monta a cadeia de bandas filhas dos totais apenas com os quadros que serao impressos.&#13;&#10;procedure MontaQuadrosTotais;&#13;&#10;var&#13;&#10;  Ultima: TfrxChild;&#13;&#10;begin&#13;&#10;  Imposto.Child := TotalICMS;&#13;&#10;  Ultima := TotalICMS;&#13;&#10;&#13;&#10;  TotalICMSFCP.Visible := ( ValorCampo(&#60;CalculoImposto.&#34;VFCP&#34;&#62;) +&#13;&#10;                            ValorCampo(&#60;CalculoImposto.&#34;VFCPST&#34;&#62;) +&#13;&#10;                            ValorCampo(&#60;CalculoImposto.&#34;vICMSUFDest&#34;&#62;) +&#13;&#10;                            ValorCampo(&#60;CalculoImposto.&#34;vFCPUFDest&#34;&#62;) ) &#62; 0;&#13;&#10;  if TotalICMSFCP.Visible then&#13;&#10;  begin&#13;&#10;    Ultima.Child := TotalICMSFCP;&#13;&#10;    Ultima := TotalICMSFCP;&#13;&#10;  end;&#13;&#10;&#13;&#10;  TotalICMSMono.Visible := ( ValorCampo(&#60;CalculoImposto.&#34;qBCMono&#34;&#62;) +&#13;&#10;                             ValorCampo(&#60;CalculoImposto.&#34;vICMSMono&#34;&#62;) +&#13;&#10;                             ValorCampo(&#60;CalculoImposto.&#34;qBCMonoReten&#34;&#62;) +&#13;&#10;                             ValorCampo(&#60;CalculoImposto.&#34;vICMSMonoReten&#34;&#62;) ) &#62; 0;&#13;&#10;  if TotalICMSMono.Visible then&#13;&#10;  begin&#13;&#10;    Ultima.Child := TotalICMSMono;&#13;&#10;    Ultima := TotalICMSMono;&#13;&#10;  end;&#13;&#10;&#13;&#10;  Ultima.Child := TotalIBSCBS;&#13;&#10;  Ultima := TotalIBSCBS;&#13;&#10;&#13;&#10;  TotalIBSCBSMono.Visible := ( ValorCampo(&#60;CalculoImposto.&#34;vIBSMono&#34;&#62;) +&#13;&#10;                               ValorCampo(&#60;CalculoImposto.&#34;vCBSMono&#34;&#62;) +&#13;&#10;                               ValorCampo(&#60;CalculoImposto.&#34;vIBSMonoReten&#34;&#62;) +&#13;&#10;                               ValorCampo(&#60;CalculoImposto.&#34;vCBSMonoReten&#34;&#62;) ) &#62; 0;&#13;&#10;  if TotalIBSCBSMono.Visible then&#13;&#10;  begin&#13;&#10;    Ultima.Child := TotalIBSCBSMono;&#13;&#10;    Ultima := TotalIBSCBSMono;&#13;&#10;  end;&#13;&#10;&#13;&#10;  ISSQN.Visible := ( ValorCampo(&#60;ISSQN.&#34;vSERV&#34;&#62;) +&#13;&#10;                     ValorCampo(&#60;ISSQN.&#34;vBC&#34;&#62;) +&#13;&#10;                     ValorCampo(&#60;ISSQN.&#34;vISS&#34;&#62;) ) &#62; 0;&#13;&#10;  if ISSQN.Visible then&#13;&#10;  begin&#13;&#10;    Ultima.Child := ISSQN;&#13;&#10;    Ultima := ISSQN;&#13;&#10;  end;&#13;&#10;&#13;&#10;  Ultima.Child := nil;&#13;&#10;end;&#13;&#10;&#13;&#10;// NT 2026.010 - item 4.5: QR Code somente quando informado no XML&#13;&#10;procedure AjustaDadosAdicionais;&#13;&#10;begin&#13;&#10;  if Trim(VarToStr(&#60;Parametros.&#34;ExibeQrCodeNFe&#34;&#62;)) = &#39;S&#39; then&#13;&#10;  begin&#13;&#10;    Memo137.Width := 432.0690;&#13;&#10;    memObs.Width := 429.4746;&#13;&#10;    Memo66.Left := 432.0690;&#13;&#10;    Memo66.Width := 398.8330;&#13;&#10;    Memo180.Left := 432.0690;&#13;&#10;    Memo180.Width := 398.8330;&#13;&#10;    QuadroQrCode.Visible := True;&#13;&#10;    ImgQrCodeNFe.Visible := True;&#13;&#10;  end&#13;&#10;  else&#13;&#10;  begin&#13;&#10;    Memo137.Width := 665.7533;&#13;&#10;    memObs.Width := 663.1728;&#13;&#10;    Memo66.Left := 665.7533;&#13;&#10;    Memo66.Width := 350.9404;&#13;&#10;    Memo180.Left := 665.7533;&#13;&#10;    Memo180.Width := 350.9404;&#13;&#10;    QuadroQrCode.Visible := False;&#13;&#10;    ImgQrCodeNFe.Visible := False;&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure FaturaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Fatura.Visible     := ( VarToStr(&#60;Fatura.&#34;iForma&#34;&#62;) &#60;&#62; &#39;2&#39;);&#13;&#10;  MemoFatura.Visible := ( Trim( VarToStr(&#60;Fatura.&#34;nfat&#34;&#62;)) &#60;&#62; &#39;&#39;);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DadosProdutosOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  if Engine.FinalPass then&#13;&#10;    set(&#39;LinhasImpressas&#39;,StrToInt(get(&#39;LinhasImpressas&#39;))+1);&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DadosProdutosOnAfterCalcHeight(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  wTamRodapeMinimo : Double;&#13;&#10;begin&#13;&#10;  wTamRodapeMinimo := get(&#39;TamRodapeMinimo&#39;) + DadosProdutos.Height + ChildCorpoBottom.Height;&#13;&#10;&#13;&#10;  if ( Engine.FreeSpace &#60; wTamRodapeMinimo ) then&#13;&#10;    Engine.ShowBand( DadosProdutosFooter )&#13;&#10;  else if (StrToInt(VarToStr(&#60;Parametros.&#34;LinhasPorPagina&#34;&#62;)) &#62; 0) then&#13;&#10;  begin&#13;&#10;    if (StrToInt(get(&#39;LinhasImpressas&#39;)) = StrToInt(VarToStr(&#60;Parametros.&#34;LinhasPorPagina&#34;&#62;))) then&#13;&#10;      Engine.ShowBand(DadosProdutosFooter);&#13;&#10;  end;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DadosAdicionaisOnAfterPrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  ContDadosAdicionais.Visible := ( Trim(memContInfAdicionais.Lines.Text) &#60;&#62; &#39;&#39; );&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DuplicatasOnBeforePrint(Sender: TfrxComponent);&#13;&#10;begin&#13;&#10;  Shape1.Visible := ((&#60;Line#&#62; - 1) mod 5) = 0;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;// Canhoto lateral (modelo paisagem da NT) - somente na primeira folha de cada NF-e&#13;&#10;procedure MarcaDaguaOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  lExibe: Boolean;&#13;&#10;begin&#13;&#10;  lExibe := (&#60;Page&#62; = 1);&#13;&#10;  CanhotoLatRecebemos.Visible  := lExibe;&#13;&#10;  CanhotoLatAssinatura.Visible := lExibe;&#13;&#10;  CanhotoLatData.Visible       := lExibe;&#13;&#10;  CanhotoLatNFe.Visible        := lExibe;&#13;&#10;end;&#13;&#10;&#13;&#10;procedure Page1OnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  wTamRodapeMinimo : Double;&#13;&#10;begin&#13;&#10;  MontaQuadrosTotais;&#13;&#10;  AjustaTransportador;&#13;&#10;  AjustaDadosAdicionais;&#13;&#10;&#13;&#10;  MarcaDagua.Height := 740.0000;&#13;&#10;&#13;&#10;  wTamRodapeMinimo := 0;&#13;&#10;  if ( DadosAdicionais.Visible ) then&#13;&#10;    wTamRodapeMinimo := DadosAdicionais.Height;&#13;&#10;&#13;&#10;  set(&#39;TamRodapeMinimo&#39;, wTamRodapeMinimo );&#13;&#10;end;&#13;&#10;&#13;&#10;procedure DadosProdutosFooterOnBeforePrint(Sender: TfrxComponent);&#13;&#10;var&#13;&#10;  wTamRodapeMinimo, n, nBands : double;&#13;&#10;begin&#13;&#10;  wTamRodapeMinimo := get(&#39;TamRodapeMinimo&#39;);&#13;&#10;  nBands := ChildCorpoBottom.Height + DadosProdutosFooter.Height;&#13;&#10;  n := wTamRodapeMinimo + nBands;&#13;&#10;&#13;&#10;  if (&#60;PAGE&#62; &#62; 1) then&#13;&#10;  begin&#13;&#10;    if ( ContDadosAdicionais.Visible ) and ( DadosProdutos.DataSet.Eof ) then&#13;&#10;    begin&#13;&#10;      if ( Engine.FreeSpace &#62;= ( n + memContInfAdicionais.CalcHeight ) ) then&#13;&#10;        n := n + memContInfAdicionais.CalcHeight;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;&#13;&#10;  while ((Engine.FreeSpace - ChildCorpo.Height ) &#62;= n ) do&#13;&#10;    Engine.ShowBand(ChildCorpo);&#13;&#10;&#13;&#10;  Engine.ShowBand(ChildCorpoBottom);&#13;&#10;&#13;&#10;  if (&#60;PAGE&#62; = 1) then&#13;&#10;  begin&#13;&#10;    if DadosAdicionais.Visible then&#13;&#10;    begin&#13;&#10;      Engine.ShowBand(DadosAdicionais);&#13;&#10;      wTamRodapeMinimo := wTamRodapeMinimo - DadosAdicionais.Height;&#13;&#10;    end;&#13;&#10;  end;&#13;&#10;  set(&#39;TamRodapeMinimo&#39;, wTamRodapeMinimo);&#13;&#10;end;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." OnReportPrint="frxReportOnReportPrint">
