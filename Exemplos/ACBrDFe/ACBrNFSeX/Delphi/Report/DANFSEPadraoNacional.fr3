<TfrxReport Tag="1" Version="2026.1.7" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="692223" PreviewOptions.Zoom="1" PrintOptions.Printer="FinePrint" PrintOptions.PrintOnSheet="0" PrintOptions.ShowDialog="False" ReportOptions.CreateDate="41401,6014078935" ReportOptions.Description.Text="" ReportOptions.LastChange="46232,7587432407" ScriptLanguage="PascalScript" ScriptText.Text="function DefaultText(const AValue: String; const ADefault: String): String;&#13;&#10;begin&#13;&#10;  if(Trim(AValue) &#60;&#62; &#39;&#39;) then&#13;&#10;    Result := AValue&#13;&#10;  else&#13;&#10;    Result := ADefault;&#13;&#10;end;&#13;&#10;&#13;&#10;function DefaultInteger(const AValue: Integer; const ADefault: String): String;&#13;&#10;begin&#13;&#10;  if(AValue &#60;&#62; 0) then&#13;&#10;    Result := IntToStr(AValue)&#13;&#10;  else&#13;&#10;    Result := ADefault;&#13;&#10;end;&#13;&#10;&#13;&#10;function DefaultFloat(const AValue: Double; const ADefault: String): String;&#13;&#10;begin&#13;&#10;  if(AValue &#60;&#62; 0) then&#13;&#10;    Result := FormatFloat(&#39;,#0.00&#39;, AValue)&#13;&#10;  else&#13;&#10;    Result := ADefault;&#13;&#10;end;&#13;&#10;&#13;&#10;function DefaultCurr(const AValue: Double; const ADefault: String): String;&#13;&#10;begin&#13;&#10;  if(AValue &#60;&#62; 0) then&#13;&#10;    Result := &#39;R$ &#39;+ FormatFloat(&#39;,#0.00&#39;, AValue)&#13;&#10;  else&#13;&#10;    Result := ADefault;&#13;&#10;end;&#13;&#10;&#13;&#10;function getOutrasInfo: String;&#13;&#10;var&#13;&#10;  s: String;&#13;&#10;begin&#13;&#10;  s:= &#39;&#39;;&#13;&#10;  s:= s + IIF(Trim(&#60;Servicos.&#34;NumeroProcesso&#34;&#62;) &#60;&#62; &#39;&#39;, Chr(13) + Trim(&#60;Servicos.&#34;NumeroProcesso&#34;&#62;), &#39;&#39;);&#13;&#10;  s:= s + IIF(Trim(&#60;Parametros.&#34;CodigoObra&#34;&#62;) &#60;&#62; &#39;&#39;, Chr(13) + Trim(&#60;Parametros.&#34;CodigoObra&#34;&#62;) +&#39; &#39;+  Trim(&#60;Parametros.&#34;Art&#34;&#62;), &#39;&#39;);&#13;&#10;  s:= s + IIF(Trim(&#60;Parametros.&#34;OutrasInformacoes&#34;&#62;) &#60;&#62; &#39;&#39;, Chr(13) + &#60;Parametros.&#34;OutrasInformacoes&#34;&#62;, &#39;&#39;);&#13;&#10;&#13;&#10;  if(Copy(s, 1, 1) = Chr(13)) then  // Remove quebra de linha do início do texto&#13;&#10;    s := Copy(s, 2, Length(s));&#13;&#10;&#13;&#10;  Result := s;&#13;&#10;end;&#13;&#10;&#13;&#10;function AjustaEndereco(ender: String): String;&#13;&#10;begin&#13;&#10;  if(Length(ender) &#62; 77) then&#13;&#10;    Result := Copy(ender, 1, 77) +&#39;...&#39;&#13;&#10;  else&#13;&#10;    Result := ender;&#13;&#10;end;&#13;&#10;&#13;&#10;&#13;&#10;begin&#13;&#10;&#13;&#10;end." OnReportPrint="frxReportOnReportPrint">
