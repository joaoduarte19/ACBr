{$I ACBr.inc}

unit ACBrDeRE.ConsLote;

interface

uses
  SysUtils, Classes;

type
  { TConsLoteDeRE - pedido de consulta do lote (GET <URL>/<protocolo>) }

  TConsLoteDeRE = class(TObject)
  private
    FProtocolo: string;
  public
    // Monta o endereco da consulta: o protocolo e o ultimo segmento da URL
    function MontarURL(const AURLBase: string): string;

    property Protocolo: string read FProtocolo write FProtocolo;
  end;

implementation

{ TConsLoteDeRE }

function TConsLoteDeRE.MontarURL(const AURLBase: string): string;
begin
  Result := AURLBase;

  while (Result <> '') and (Result[Length(Result)] = '/') do
    Delete(Result, Length(Result), 1);

  if Result <> '' then
    Result := Result + '/' + Trim(FProtocolo);
end;

end.
